# NOTE: use letters/digits only in passwords (they are embedded in connection URLs)

# --- Database ---
POSTGRES_USER=logadmin
POSTGRES_PASSWORD=change_me_owner_password     # owner role: worker only (DDL, retention)
APP_DB_PASSWORD=change_me_app_password         # log_app role: api + ingest, subject to Row-Level Security
POSTGRES_DB=logdb

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_PASSWORD=change_me_admin
VIEWER_PASSWORD=change_me_viewer

# --- Deployment mode ---
# Appliance: DOMAIN=localhost (Caddy issues a self-signed cert)
# SaaS:      DOMAIN=yourname.duckdns.org (Caddy gets Let's Encrypt automatically)
DOMAIN=localhost

# --- Retention / alerting / ingest ---
RETENTION_DAYS=7
ALERT_WEBHOOK_URL=
DEFAULT_TENANT=demoA

# --- Enrichment (optional) ---
# Run `make geoip` once to download the offline GeoIP database; without it only reverse DNS runs.
GEOIP_DB_PATH=/data/geoip/city.mmdb
RDNS_TIMEOUT=1.0
